# ==========================================================================
# Conecta Cidadão - Variáveis de Ambiente do Backend (Exemplo)
# Copie este arquivo para `backend/.env` e preencha com as credenciais reais
# do seu projeto Supabase (PostgreSQL). Nunca versione o arquivo `.env`!
# ==========================================================================

SUPABASE_DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.seu_project_ref
SUPABASE_DB_PASSWORD=sua_senha_segura_aqui

# Google Maps Platform / Street View Static API (Opcional)
# Se configurada, o mapa carrega automaticamente as fotografias de fachada do Google Street View
GOOGLE_MAPS_API_KEY=


